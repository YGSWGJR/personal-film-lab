{
  "name": "personal-film-lab",
  "version": "0.1.9",
  "private": true,
  "description": "个人拉片工作台 — 导入影片、切分镜头、标注静帧、导出分镜本",
  "main": "./out/main/index.js",
  "author": "Personal Film Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YGSWGJR/personal-film-lab.git"
  },
  "homepage": "https://github.com/YGSWGJR/personal-film-lab#readme",
  "bugs": {
    "url": "https://github.com/YGSWGJR/personal-film-lab/issues"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite build && electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke-test --disable-gpu",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "postinstall": "electron-builder install-app-deps",
    "prepare:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-runtime-assets.ps1",
    "prepare:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-python-runtime.ps1",
    "prepare:local-ai": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-local-ai.ps1",
    "prepare:transnetv2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-transnetv2-model.ps1",
    "package:local-ai": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-local-ai.ps1",
    "build": "electron-vite build && npm run prepare:python && electron-builder",
    "build:dir": "electron-vite build && npm run prepare:python && electron-builder --dir",
    "build:full": "npm run build && npm run package:local-ai",
    "build:core": "npm run build",
    "build:core:dir": "npm run build:dir"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "com.personalfilmlab.desktop",
    "productName": "个人拉片工作台",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "USER_GUIDE.md",
          "FEATURES.md",
          "个人拉片工作台使用说明.docx"
        ]
      },
      {
        "from": "resources/mpv",
        "to": "mpv",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      },
      {
        "from": "src/main/detect/python",
        "to": "detect/python",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "resources/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/local-ai/bridge",
        "to": "local-ai/bridge",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/transnetv2",
        "to": "transnetv2",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.14.0",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "koffi": "^3.3.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "koffi@3.3.3": true,
    "electron-winstaller@5.4.0": true
  }
}
