# dependencies
node_modules/

# build output
dist/
out/
release/
*.tsbuildinfo

# logs
*.log
npm-debug.log*

# runtime data
*.db
*.db-journal
*.db-wal
*.db-shm

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
# 运行时二进制（体积大，本地放置；见 resources/mpv/README.md）
resources/mpv/*.dll
resources/mpv/*.dll.a
resources/mpv/*.lib
resources/mpv/mpv.exe

# 本地测试素材
assets/samples/
# FFmpeg 二进制（体积大，本地放置；见 README 媒体处理小节）
resources/ffmpeg/*.exe

# 内嵌 Python 运行时（由 scripts/prepare-python-runtime.ps1 本地生成）
resources/python/

# Python 缓存
__pycache__/
*.pyc
